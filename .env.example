# AWS region shared by DynamoDB, S3 and SQS
AWS_REGION=ap-southeast-1

# DynamoDB table names
USERS_TABLE=de-users
SIMULATIONS_TABLE=de-simulations
RESULTS_TABLE=de-simulation-results
UNIQUENESS_TABLE=de-uniqueness

# DynamoDB endpoint override. Points at DynamoDB Local for local dev / tests.
# MUST be empty in AWS so the SDK resolves the real regional endpoint.
DYNAMODB_ENDPOINT=http://localhost:8000

# Secrets for signing access (1h) and refresh (7d) tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Comma-separated list of allowed frontend origins (default: allow all)
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Server port (default 3000)
PORT=3000

# Winston log level: error | warn | info | debug (default info)
LOG_LEVEL=info

# AWS credentials — shared by DynamoDB, S3 and SQS.
# LEAVE BOTH EMPTY: env credentials outrank ~/.aws/credentials, so a value
# here would break real S3/SQS from host dev. Empty = default credential chain
# (~/.aws/credentials locally, EC2 IAM role in AWS). The docker-compose
# backend service sets dummy `local`/`local` for the container only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 (profile picture uploads) — uses the AWS_REGION defined above
# Bucket where profile-images/{userId} objects are stored (versioning enabled, public-read)
S3_BUCKET_NAME=your-profile-images-bucket

# AWS SQS (simulation job queue for EC2 workers)
# Local dev points at ElasticMQ (docker compose up -d elasticmq):
#   SQS_QUEUE_URL=http://localhost:9324/000000000000/DE-Queue
#   SQS_ENDPOINT=http://localhost:9324
# In AWS use the real full queue URL and leave SQS_ENDPOINT empty:
#   SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/DE-Queue
#   SQS_ENDPOINT=
SQS_QUEUE_URL=http://localhost:9324/000000000000/DE-Queue

# SQS endpoint override. Local dev/test only (ElasticMQ). MUST be empty in AWS
# so the SDK resolves the real regional endpoint — same convention as DYNAMODB_ENDPOINT.
SQS_ENDPOINT=http://localhost:9324
