{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express backend for website project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/create-tables.js",
    "db:create:test": "node scripts/create-tables.js --test",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1133.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/client-sqs": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "forceExit": true,
    "detectOpenHandles": true
  }
}
